; Engine configuration file.
; Crust Rush native build. Edit through the Godot editor's Project Settings or here.

config_version=5

[application]

config/name="Crust Rush"
config/description="Pizza-kart racing. Native build of the Crust Rush web game."
config/version="0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
run/max_fps=0
boot_splash/bg_color=Color(0.086, 0.047, 0.035, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/size/mode=2

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.ios="metal"
rendering_device/driver.macos="metal"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.53, 0.75, 0.92, 1)
